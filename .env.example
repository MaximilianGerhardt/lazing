# =============================================================================
# laz.ing — example environment file
# -----------------------------------------------------------------------------
# Copy to `.env.local` and fill in at least the REQUIRED block, then run
# `bash scripts/setup.sh` (see README.md / docs/install/local.md).
#
# Brand name in the UI is "laz.ing". The code identifier prefix `LAZYOS_*` is a
# legacy schema kept for backward compatibility — do NOT rename these keys.
#
# Every value below is a PLACEHOLDER. Never commit real secrets, real e-mail
# addresses, tunnel URLs or team IDs into this file.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — the app will refuse to operate sensibly without these
# -----------------------------------------------------------------------------

# HMAC secret for session cookies. Generate >= 32 random bytes (hex):
#   node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
LAZYOS_AUTH_SECRET=replace-with-32-random-bytes-hex

# Operator bootstrap / solo-self-host master-login code. >= 16 chars, not a
# dictionary word. Treat it like a root password.
LAZYOS_ACCESS_CODE=replace-with-a-long-random-passphrase

# AES-256-GCM key for credentials encrypted at rest (incl. per-user plan tokens).
# Exactly 64 hex chars (= 32 bytes):
#   node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
LAZYOS_CREDENTIAL_KEY=replace-with-64-hex-chars

# Founder / owner e-mail (used by the setup script to create the first user).
LAZYOS_OWNER_EMAIL=you@example.com


# -----------------------------------------------------------------------------
# FIRST-RUN ONBOARDING (Track B)
# -----------------------------------------------------------------------------

# When "true", the first-run gate redirects authenticated browser sessions to
# the /oss-onboarding wizard until it completes (self-heal -> install -> engine
# connect -> workspace -> finalize). Leave empty/false to disable the gate
# (e.g. for an already-provisioned server). API routes are never gated.
LAZYOS_OSS_MODE=true


# -----------------------------------------------------------------------------
# PATHS — where state lives on disk (sensible defaults; override if needed)
# -----------------------------------------------------------------------------

# SQLite database file. Default: ~/.lazyos/lazyos.db
LAZYOS_DB_PATH=

# Root directory under which agent project checkouts are created.
LAZYOS_PROJECTS_ROOT=

# Root of the laz.ing repository checkout (used by some scripts/agents).
LAZYOS_REPO_ROOT=

# Directory for application log files.
LAZYOS_LOG_DIR=

# Directory for the lexical RAG cache.
LAZYOS_RAG_CACHE_DIR=

# Directory for per-user encrypted credentials.
LAZYOS_USER_CREDS_DIR=

# Sandbox root for per-user file operations.
LAZYOS_USER_SANDBOX_ROOT=

# Root for cloud-disk storage (VPS deployments).
LAZYOS_CLOUD_ROOT=

# Skill definition directories (engine-specific overrides optional).
LAZYOS_SKILLS_DIR=
LAZYOS_CLAUDE_SKILLS_DIR=
LAZYOS_CODEX_SKILLS_DIR=

# Plan file consumed by the planner (optional).
LAZYOS_PLAN_FILE=

# Production build output directory (advanced; default `.next`).
LAZYOS_DIST_DIR=


# -----------------------------------------------------------------------------
# BRAND / MODE / RUNTIME
# -----------------------------------------------------------------------------

# Override the user-facing brand name (default: "laz.ing").
LAZYOS_BRAND_NAME=

# Display name for the owner/founder user (default: "Owner").
LAZYOS_OWNER_DISPLAY_NAME=

# HTTP port the web app binds to (default 4200).
LAZYOS_PORT=4200

# Canonical base URL of this instance (used for links in mails, etc.).
LAZYOS_BASE_URL=http://localhost:4200

# Public-facing URL (if different from base, e.g. behind a tunnel/proxy).
LAZYOS_PUBLIC_URL=

# Web URL used in some server-side links.
LAZYOS_WEB_URL=

# Optional separate base URL used for preview/share links.
LAZYOS_PREVIEW_BASE_URL=

# Comma-separated list of allowed CORS origins.
LAZYOS_CORS_ORIGINS=

# Default org/workspace identifiers and labels created on first boot.
LAZYOS_DEFAULT_ORG_ID=
LAZYOS_DEFAULT_ORG_NAME=
LAZYOS_DEFAULT_WORKSPACE_ID=
LAZYOS_DEFAULT_WORKSPACE_LABEL=

# Bootstrap an org wrapper around the default workspace (true/false).
LAZYOS_WORKSPACE_ORG_BOOTSTRAP=

# Build/dispatch behaviour toggles.
LAZYOS_BUILD_MODE=
LAZYOS_DISABLE_AUTO_DISPATCH=
LAZYOS_AUTODISPATCH_PAUSE_MS=
LAZYOS_AUTO_MERGE_RUN=

# Permission enforcement level for destructive operations.
LAZYOS_PERMISSION_ENFORCEMENT=

# Filesystem sandbox toggle for agent file operations.
LAZYOS_FS_SANDBOX=

# Sniper-loop / workstream timing knobs (milliseconds).
LAZYOS_SNIPER_PAUSE_MS=
LAZYOS_STUCK_AGING_MS=
LAZYOS_WS_STALE_MS=
LAZYOS_WS_ORPHAN_RESUME_MS=
LAZYOS_MAGIC_TTL_MS=
LAZYOS_SHUTDOWN_HARD_MS=

# Graph/orchestration depth + drift limits.
LAZYOS_TIER_DEPTH=
LAZYOS_DRIFT_MAX_PER_RUN=

# Streaming behaviour.
LAZYOS_STREAMING_SNAPSHOTS=

# Surface-style lint threshold (CI/dev tooling).
LAZYOS_SURFACE_LINT_THRESHOLD=

# Audit: store full prompts in the reasoning audit (privacy-sensitive — keep off
# unless you understand the implications).
LAZYOS_AUDIT_FULL_PROMPTS=

# Token-per-minute budget + logging.
LAZYOS_MAX_TPM_BUDGET=
LAZYOS_TPM_LOG=

# Serve the production build locally / tailnet host hint.
LAZYOS_SERVE_LOCAL=
LAZYOS_TAILNET_HOST=


# -----------------------------------------------------------------------------
# ENGINES / LLM
# -----------------------------------------------------------------------------

# Path to the Claude Code CLI binary (optional; only for real Claude spawns).
LAZYOS_CLAUDE_BIN=

# Path to the Codex CLI binary (optional).
LAZYOS_CODEX_BIN=
# Allow Codex to write to disk (true/false).
LAZYOS_CODEX_WRITE=
# Model name passed to the Codex engine.
LAZYOS_CODEX_MODEL=

# Local Ollama endpoint + default model (for pricing-free local inference).
LAZYOS_OLLAMA_URL=http://localhost:11434
LAZYOS_OLLAMA_MODEL=

# Default local model name (non-Ollama local paths).
LAZYOS_LOCAL_MODEL=

# Default Anthropic model name used by the hosted engine.
LAZYOS_ANTHROPIC_MODEL=

# Model used for image generation.
LAZYOS_IMAGEGEN_MODEL=

# Anthropic / OpenAI API keys (only if you use the API instead of a CLI plan).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Force using an API key even when a CLI plan is available (true/false).
LAZYOS_FORCE_API_KEY=


# -----------------------------------------------------------------------------
# AGENT SERVER (long-running process, default port 4201)
# -----------------------------------------------------------------------------

LAZYOS_AGENT_HOST=
LAZYOS_AGENT_PORT=4201
LAZYOS_AGENT_URL=
# Bearer secret shared between web app and agent server.
LAZYOS_AGENT_SECRET=
# Test mode for the agent server (CI/dev).
LAZYOS_AGENT_TEST_MODE=

# Bearer keys for service-to-service calls (CLI, chat, cron).
LAZYOS_CHAT_KEY=
LAZYOS_CLI_KEY=
LAZYOS_CRON_KEY=

# Endpoint the agent server emits events to.
LAZYOS_EMIT_URL=


# -----------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# -----------------------------------------------------------------------------

# --- GitHub OAuth (connect GitHub accounts) ---
LAZYOS_GITHUB_CLIENT_ID=
LAZYOS_GITHUB_CLIENT_SECRET=
LAZYOS_GITHUB_OAUTH_CALLBACK=

# --- E-mail / magic links (Resend) ---
# Without these, magic-link mails are printed to the server console instead.
LAZYOS_EMAIL_PROVIDER=
LAZYOS_EMAIL_FROM=
RESEND_API_KEY=
LAZYOS_RESEND_API_KEY=
LAZYOS_RESEND_REGION=

# --- Web Push (VAPID) ---
# Generate a key pair:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Push rate-limit + kill switch.
LAZYOS_DISABLE_PUSH=
LAZYOS_MAX_PUSHES_PER_DAY=
LAZYOS_PUSH_URL=
LAZYOS_PUSH_SECRET=

# --- Speech-to-text (optional transcription backend) ---
LAZYOS_STT_URL=
LAZYOS_STT_KEY=

# --- Hybrid VPS bridge (cloud + self-host proxy) ---
LAZYOS_VPS_BRIDGE_SECRET=

# --- Allow-list of e-mails permitted to log in (comma-separated) ---
LAZYOS_ALLOWED_EMAILS=

# --- Additional encryption keys (advanced) ---
# Master key-encryption-key for envelope encryption.
LAZYOS_MASTER_KEK=
# TOTP/2FA signing key.
LAZYOS_2FA_KEY=


# -----------------------------------------------------------------------------
# DEV / TEST ONLY — do not set in production
# -----------------------------------------------------------------------------

# Auto-login as the owner in dev (true/false). NEVER enable in production.
LAZYOS_DEV_AUTO_LOGIN=
# Fake the rate limiter / disable foreign keys / skip DB in tests.
LAZYOS_FAKE_RATE_LIMIT=
LAZYOS_TEST_DISABLE_FK=
LAZYOS_TWIN_SKIP_DB=
# Connector live-mode toggle (off = stubbed connectors).
LAZYOS_CONNECTOR_LIVE=
# Context identifiers injected by the runtime (do not set manually).
LAZYOS_SESSION_ID=
LAZYOS_WORKSPACE_ID=
LAZYOS_ROUTINE_RUN=
